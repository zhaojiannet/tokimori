    "Can’t turn on: another timer opens %@ at the same time on %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعذر التشغيل: يفتح مؤقت آخر %@ في نفس الوقت (%@)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschalten nicht möglich: Ein anderer Timer öffnet %@ zur selben Zeit (%@)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede activar: otro temporizador abre %@ a la misma hora (%@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activation impossible : un autre minuteur ouvre %@ à la même heure (%@)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चालू नहीं किया जा सकता: एक अन्य टाइमर इसी समय %@ खोलता है (%@)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menyalakan: pengatur waktu lain juga membuka %@ pada waktu yang sama di %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにできません：別のタイマーが%2$@の同じ時刻に%1$@を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켤 수 없음: 다른 타이머가 %2$@ 같은 시간에 %1$@을(를) 엽니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ativar: outro timer abre %@ no mesmo horário (%@)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно включить: другой таймер открывает %@ в то же время (%@)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดไม่ได้: ตัวจับเวลาอื่นเปิด %@ ในเวลาเดียวกันใน %@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể bật: một hẹn giờ khác cũng mở %@ vào cùng giờ vào %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法开启：另一个定时器会在%2$@的同一时间打开 %1$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法開啟：另一個計時器會在%2$@的同一時間打開 %1$@。"
          }
        }
      }
    },
