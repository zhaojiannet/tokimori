    "Allow Tokimori in System Settings › General › Login Items to finish turning this on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Tokimori في إعدادات النظام › عام › عناصر تسجيل الدخول لإكمال التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Tokimori unter „Systemeinstellungen“ › „Allgemein“ › „Anmeldeobjekte“, um dies abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Tokimori en Ajustes del Sistema › General › Ítems de inicio para terminar de activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Tokimori dans Réglages Système › Général › Ouverture pour terminer l’activation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे चालू करना पूरा करने के लिए सिस्टम सेटिंग्ज़ › सामान्य › लॉगइन आइटम में Tokimori को अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Tokimori di Pengaturan Sistem › Umum › Item Masuk untuk menyelesaikan pengaktifan ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「一般」›「ログイン項目」で Tokimori を許可すると、設定が完了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정을 완료하려면 시스템 설정 › 일반 › 로그인 항목에서 Tokimori를 허용하십시오."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o Tokimori em Ajustes do Sistema › Geral › Itens de Início para concluir a ativação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Tokimori в разделе «Системные настройки» › «Основные» › «Объекты входа», чтобы завершить включение."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต Tokimori ในการตั้งค่าระบบ › ทั่วไป › รายการเข้าสู่ระบบ เพื่อเปิดใช้ให้เสร็จสมบูรณ์"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Tokimori trong Cài đặt hệ thống › Cài đặt chung › Mục đăng nhập để hoàn tất việc bật."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”›“通用”›“登录项”中允许 Tokimori，才能完成开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」›「一般」›「登入項目」中允許 Tokimori，才能完成開啟。"
          }
        }
      }
    },
