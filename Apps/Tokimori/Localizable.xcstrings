    "Stop Until %@: stays off for the rest of this period and turns on again automatically next time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف حتى %@: يظل متوقفًا لبقية هذه الفترة ويعمل تلقائيًا مرة أخرى في المرة القادمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppen bis %@: Bleibt für den Rest dieses Zeitraums aus und schaltet sich beim nächsten Mal automatisch wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detener hasta %@: permanece desactivado el resto de este periodo y se vuelve a activar automáticamente la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter jusqu’à %@ : reste désactivé pour le reste de cette période et se réactive automatiquement la prochaine fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ तक रोकें: इस अवधि के बाकी समय के लिए बंद रहता है और अगली बार अपने आप फिर से चालू हो जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hentikan Hingga %@: tetap mati selama sisa periode ini dan menyala lagi secara otomatis di periode berikutnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@まで停止：この時間帯の残りはオフのままで、次回は自動的に再びオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 중단: 이번 기간의 남은 시간 동안 꺼져 있다가 다음번에 자동으로 다시 켜집니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar Até %@: fica desativado pelo resto deste período e é ativado automaticamente de novo na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановить до %@: остается выключенным до конца этого периода и в следующий раз включится автоматически."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดจนถึง %@: ปิดไว้ตลอดช่วงเวลานี้ที่เหลือ และจะเปิดอีกครั้งโดยอัตโนมัติในครั้งถัดไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dừng đến %@: tắt trong phần còn lại của khung giờ này và tự động bật lại vào lần tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停到 %@：本时段不再防睡眠，下个时段照常自动开启。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停至 %@：在此時段剩餘時間內保持關閉，下次會自動重新開啟。"
          }
        }
      }
    },
