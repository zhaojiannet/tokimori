          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดกำหนดการเหล่านี้"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt các lịch này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用这些计划"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉這些排程"
          }
        }
      }
    },
    "Turn Off These Schedules: they never turn on automatically again. You can turn them back on in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف هذه الجداول: لن تعمل تلقائيًا مرة أخرى أبدًا. يمكنك إعادة تشغيلها في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeitpläne deaktivieren: Sie schalten sich nie mehr automatisch ein. Du kannst sie in den Einstellungen wieder aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar estos horarios: ya no se activarán automáticamente. Puedes volver a activarlos en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver ces horaires : ils ne s’activeront plus jamais automatiquement. Vous pouvez les réactiver dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये शेड्यूल बंद करें: ये फिर कभी अपने आप चालू नहीं होंगे। आप इन्हें सेटिंग्ज़ में फिर से चालू कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan Semua Jadwal Ini: jadwal tidak akan pernah menyala otomatis lagi. Anda dapat menyalakannya kembali di Pengaturan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのスケジュールをオフにする：今後自動的にオンになることはありません。「設定」で再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 일정들 끄기: 더 이상 자동으로 켜지지 않습니다. 설정에서 다시 켤 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar Estes Agendamentos: eles nunca mais serão ativados automaticamente. Você pode reativá-los nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключить эти расписания: они больше не будут включаться автоматически. Их можно снова включить в Настройках."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดกำหนดการเหล่านี้: จะไม่เปิดเองโดยอัตโนมัติอีก คุณสามารถเปิดอีกครั้งได้ในการตั้งค่า"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt các lịch này: các lịch sẽ không bao giờ tự động bật lại. Bạn có thể bật lại trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用这些计划：以后都不自动开启，可以在设置里重新启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉這些排程：它們不會再自動開啟。你可以在「設定」中重新開啟。"
          }
        }
      }
    },
