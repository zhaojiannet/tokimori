        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका Mac सामान्य रूप से स्लीप में जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac dapat tidur seperti biasa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macは通常どおりスリープできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac이 평소처럼 잠자기에 들어갈 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mac pode entrar em repouso normalmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac может засыпать как обычно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac สามารถพักเครื่องได้ตามปกติ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
