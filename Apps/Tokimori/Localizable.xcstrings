    "Your Mac can sleep as usual." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للـ Mac الخلود إلى النوم كالمعتاد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mac kann wie gewohnt in den Ruhezustand wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac puede entrar en reposo como siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre Mac peut suspendre son activité comme d’habitude."
          }
