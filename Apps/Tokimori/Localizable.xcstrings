    "Tokimori connects to the internet only when you click Check for Updates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتصل Tokimori بالإنترنت إلا عند النقر على «التحقق من وجود تحديثات»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Internet verbindet sich Tokimori nur, wenn du auf „Nach Updates suchen“ klickst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokimori solo se conecta a internet cuando haces clic en «Buscar actualizaciones»."
          }
        },
        "fr" : {
          "stringUnit" : {
